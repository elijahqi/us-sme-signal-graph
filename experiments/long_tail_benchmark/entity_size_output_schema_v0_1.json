{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operating_entity_id", "employee_evidence_status", "employee_lower", "employee_upper", "currentness", "evidence_scope", "descriptive_scale_band", "owner_only_supported", "federal_small_business_representation", "supporting_review_ids", "evidence_quotes", "confidence", "rationale"],
        "properties": {
          "operating_entity_id": {"type": "string"},
          "employee_evidence_status": {"enum": ["exact", "approximate", "range", "lower_bound", "upper_bound", "historical_only", "ambiguous_scope", "none"]},
          "employee_lower": {"type": ["integer", "null"], "minimum": 0},
          "employee_upper": {"type": ["integer", "null"], "minimum": 0},
          "currentness": {"enum": ["current_explicit", "undated_present_tense", "historical", "ambiguous", "not_applicable"]},
          "evidence_scope": {"enum": ["operating_entity", "corporate_group", "multi_state_partial_entity", "facility_only", "ambiguous", "not_applicable"]},
          "descriptive_scale_band": {"enum": ["owner_only_supported", "micro_1_9_supported", "small_10_99_supported", "mid_100_499_supported", "large_500_plus_supported", "bounded_but_crosses_bands", "unknown"]},
          "owner_only_supported": {"type": "boolean"},
          "federal_small_business_representation": {"enum": ["explicit_sam_or_sba_page_claim", "named_federal_program_page_claim", "generic_or_ambiguous_claim", "none"]},
          "supporting_review_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_quotes": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 500}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "rationale": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
