{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {"results": {"type": "array", "minItems": 1, "maxItems": 10, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["review_id", "size_evidence_status", "employee_lower", "employee_upper", "owner_only_supported", "sba_status_supported", "evidence_quote", "confidence", "rationale"],
    "properties": {
      "review_id": {"type": "string"},
      "size_evidence_status": {"enum": ["exact_employee_count", "employee_range", "employee_lower_bound", "employee_upper_bound", "owner_only_or_nonemployer_explicit", "sba_self_certification_explicit", "insufficient"]},
      "employee_lower": {"type": ["integer", "null"], "minimum": 0},
      "employee_upper": {"type": ["integer", "null"], "minimum": 0},
      "owner_only_supported": {"type": "boolean"},
      "sba_status_supported": {"type": "boolean"},
      "evidence_quote": {"type": "string", "maxLength": 500},
      "confidence": {"enum": ["high", "medium", "low"]},
      "rationale": {"type": "string", "maxLength": 800}
    }
  }}}
}
