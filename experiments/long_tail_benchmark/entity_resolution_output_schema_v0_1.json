{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id", "corporate_group_count", "operating_entity_count", "merge_groups", "decision", "confidence", "rationale"],
        "properties": {
          "cluster_id": {"type": "string"},
          "corporate_group_count": {"type": "integer", "minimum": 1},
          "operating_entity_count": {"type": "integer", "minimum": 1},
          "merge_groups": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
          "decision": {"enum": ["single_operating_entity", "single_corporate_multiple_operating_entities", "multiple_unrelated_entities", "unresolved"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "rationale": {"type": "string", "maxLength": 1200}
        }
      }
    }
  }
}
