{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "same_operating_entity", "same_corporate_group", "confidence", "rationale"],
        "properties": {
          "pair_id": {"type": "string"},
          "same_operating_entity": {"enum": ["yes", "no", "unclear"]},
          "same_corporate_group": {"enum": ["yes", "no", "unclear"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "rationale": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
